# Endpoint del backend Python.
API_URL=http://127.0.0.1:8000/comandos

# Números autorizados, separados por coma.
# Usar código de país y característica, solo dígitos.
# Ejemplo Argentina: 54911XXXXXXXX
ALLOWED_NUMBERS=54911XXXXXXXX

# Activar grupos cuando el bot se use en un grupo de trabajo.
ALLOW_GROUPS=false

# Los grupos deben autorizarse explícitamente.
# Formato habitual: 1234567890-1234567890@g.us
# Todos los integrantes de un grupo autorizado pueden usar el bot.
ALLOWED_GROUP_IDS=

# Tiempo máximo de espera para la API.
API_TIMEOUT_MS=10000

# Muestra en consola por qué un mensaje fue aceptado o ignorado.
DEBUG_MESSAGES=true


# Envía una presentación de Abadion una sola vez por grupo autorizado.
# El estado queda guardado localmente para no repetirla al reiniciar.
SEND_GROUP_WELCOME=true


# En grupos, no responder a mensajes normales que la API no reconozca como comandos.
SILENT_UNKNOWN_GROUP_MESSAGES=true
