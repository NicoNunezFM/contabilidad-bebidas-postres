# Endpoint del backend Python.
API_URL=http://127.0.0.1:8000/comandos

# Números autorizados, separados por coma.
# Usar código de país y característica, solo dígitos.
# Ejemplo Argentina: 54911XXXXXXXX
ALLOWED_NUMBERS=54911XXXXXXXX

# Grupos desactivados por defecto.
ALLOW_GROUPS=false

# Opcional. Si ALLOW_GROUPS=true, podés restringir a IDs concretos.
# Formato habitual: 1234567890-1234567890@g.us
ALLOWED_GROUP_IDS=

# Tiempo máximo de espera para la API.
API_TIMEOUT_MS=10000

# Muestra en consola por qué un mensaje fue aceptado o ignorado.
DEBUG_MESSAGES=true
